{
  "manifest_version": 3,
  "name": "MVP Instagram Tracker",
  "version": "2.1.0",
  "description": "Complete Instagram follower/following lists, follow-back analysis and change tracking. All data stays in your browser.",
  "homepage_url": "https://github.com/trader1ek/MVP-INSTAGRAM-TRACKER",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open MVP Instagram Tracker",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Open MVP Instagram Tracker"
    }
  }
}
